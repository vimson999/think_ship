# ===== 基础配置 =====
# 环境设置 (development/staging/production)
ENVIRONMENT=development
# 是否开启调试模式
DEBUG=true

# ===== 服务器配置 =====
# 服务器地址和端口
HOST=0.0.0.0
PORT=8000

# 跨域配置（逗号分隔）
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000

# ===== 数据库配置 =====
# PostgreSQL数据库配置
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=think_ship
POSTGRES_PORT=5432

# 数据库连接池配置
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# ===== Redis配置 =====
# Redis缓存配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===== Celery任务队列配置 =====
# Celery Broker和Backend（使用不同的Redis数据库）
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ===== AI服务配置 =====
# OpenAI配置
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_MAX_TOKENS=2048
OPENAI_TEMPERATURE=0.7

# Anthropic配置
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-sonnet-20240229

# AI服务超时配置
AI_REQUEST_TIMEOUT=60
AI_MAX_RETRIES=3

# ===== 爬虫配置 =====
# 请求配置
REQUEST_TIMEOUT=30
REQUEST_DELAY=1.0
MAX_CONCURRENT_REQUESTS=10

# 代理配置
PROXY_ENABLED=false
PROXY_URLS=

# ===== 文件存储配置 =====
# 本地存储
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# 对象存储配置 (local/oss/minio)
OBJECT_STORAGE_TYPE=local
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
OSS_ENDPOINT=

# ===== 安全配置 =====
# 限流配置（每分钟请求数）
RATE_LIMIT_PER_MINUTE=60

# ===== 监控配置 =====
# Sentry错误监控
SENTRY_DSN=

# 日志配置
LOG_LEVEL=INFO
LOG_FILE_MAX_SIZE=100 MB
LOG_FILE_RETENTION=30 days

# ===== 业务配置 =====
# 内容生成配置
CONTENT_MIN_LENGTH=100
CONTENT_MAX_LENGTH=5000

# 发布配置
MAX_ACCOUNTS_PER_PLATFORM=50
PUBLISH_RETRY_TIMES=3
PUBLISH_RETRY_DELAY=60

# 热点采集配置
HOT_TOPIC_FETCH_INTERVAL=300
HOT_TOPIC_MIN_SCORE=0.6

# ===== 开发环境特殊配置 =====
# 开发环境下可以设置为false来禁用某些检查
STRICT_MODE=false